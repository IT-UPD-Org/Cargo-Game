{
  "name": "cargo-game",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/setup-wasm.mjs",
    "dev": "tsx watch src/server.ts",
    "build:wasm": "node scripts/setup-wasm.mjs",
    "build": "tsc",
    "build:full": "npm run build:wasm && npm run build:static && npm run build",
    "build:static": "node scripts/build-static.mjs",
    "start": "node dist/server.js",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongodb": "^6.13.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "blueimp-md5": "^2.19.0",
    "esbuild": "^0.28.2",
    "google-closure-compiler": "^20261019.0.0",
    "javascript-obfuscator": "^5.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
